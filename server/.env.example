PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection (include database name in path, e.g. /yourtube)
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/yourtube?retryWrites=true&w=majority

# Razorpay test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# SMTP for subscription confirmation emails (optional — logs to console if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=YourTube Premium <noreply@yourtube.com>
